# Standalone mode: left half is central.
# Dongle mode: build the left half with -DCONFIG_ZMK_SPLIT_ROLE_CENTRAL=n (see build.yaml).
if SHIELD_ERGO_S1_LEFT

config ZMK_SPLIT_ROLE_CENTRAL
    default y

endif

if SHIELD_ERGO_S1_LEFT || SHIELD_ERGO_S1_RIGHT

config ZMK_KEYBOARD_NAME
    default "Ergo S1"

config ZMK_SPLIT
    default y

endif

if SHIELD_ERGO_S1_DONGLE

config ZMK_KEYBOARD_NAME
    default "Ergo S1"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# 5 host profiles + 2 halves
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

# 128x32 SSD1306 OLED on the dongle
config ZMK_DISPLAY
    default y

if ZMK_DISPLAY

config I2C
    default y

config SSD1306
    default y

endif # ZMK_DISPLAY

endif
