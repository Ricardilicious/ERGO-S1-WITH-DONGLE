/*
 * Ergo S1 — matrix transform + physical layout (shared by both halves and the dongle).
 *
 * Global matrix is 6 rows x 12 columns.
 *   Left half : columns 0..5  (col 0 = outermost / leftmost)
 *   Right half: columns 6..11 (col 11 = outermost / rightmost; overlay sets col-offset = <6>)
 *
 * Row 4 (bottom row) only uses C1..C4 on each half.
 * Row 5 is the thumb cluster: column jumpers C0 Fn, C1 Ctrl, C2 Home, C3 Alt, C4 End, C5 Shift.
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include <physical_layouts.dtsi>

/ {
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <12>;
        rows = <6>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)    RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)    RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)    RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)    RC(3,6) RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        RC(4,1) RC(4,2) RC(4,3) RC(4,4)                    RC(4,7) RC(4,8) RC(4,9) RC(4,10)
/* Left thumbs : Shift    Fn       Ctrl     Alt      Home     End                                   */
        RC(5,5) RC(5,0) RC(5,1) RC(5,3) RC(5,2) RC(5,4)
/* Right thumbs: PgDn     PgUp     Caps     Ctrl     Enter    Space                                 */
/* PROVISIONAL: assumes the right half uses the same column jumpers as the left (C0 Enter, C1 Ctrl, */
/* C2 PgUp, C3 Caps, C4 PgDn, C5 Space). Right Cn = global column 11-n. Fix once the half is wired. */
        RC(5,7) RC(5,9) RC(5,8) RC(5,10) RC(5,11) RC(5,6)
        >;
    };

    ergo_s1_layout: ergo_s1_layout {
        compatible = "zmk,physical-layout";
        display-name = "Ergo S1";
        transform = <&default_transform>;

        /*                    w   h     x     y     rot   rx   ry   (1/100 u, 1/100 deg) */
        keys
            = <&key_physical_attrs 100 100   50   25       0    0    0>
            , <&key_physical_attrs 100 100  150   25       0    0    0>
            , <&key_physical_attrs 100 100  250    0       0    0    0>
            , <&key_physical_attrs 100 100  350    0       0    0    0>
            , <&key_physical_attrs 100 100  450    0       0    0    0>
            , <&key_physical_attrs 100 100  550    0       0    0    0>
            , <&key_physical_attrs 100 100 1150    0       0    0    0>
            , <&key_physical_attrs 100 100 1250    0       0    0    0>
            , <&key_physical_attrs 100 100 1350    0       0    0    0>
            , <&key_physical_attrs 100 100 1450    0       0    0    0>
            , <&key_physical_attrs 100 100 1550   25       0    0    0>
            , <&key_physical_attrs 100 100 1650   25       0    0    0>
            , <&key_physical_attrs 150 100    0  125       0    0    0>
            , <&key_physical_attrs 100 100  150  125       0    0    0>
            , <&key_physical_attrs 100 100  250  100       0    0    0>
            , <&key_physical_attrs 100 100  350  100       0    0    0>
            , <&key_physical_attrs 100 100  450  100       0    0    0>
            , <&key_physical_attrs 100 100  550  100       0    0    0>
            , <&key_physical_attrs 100 100 1150  100       0    0    0>
            , <&key_physical_attrs 100 100 1250  100       0    0    0>
            , <&key_physical_attrs 100 100 1350  100       0    0    0>
            , <&key_physical_attrs 100 100 1450  100       0    0    0>
            , <&key_physical_attrs 100 100 1550  125       0    0    0>
            , <&key_physical_attrs 150 100 1650  125       0    0    0>
            , <&key_physical_attrs 150 100    0  225       0    0    0>
            , <&key_physical_attrs 100 100  150  225       0    0    0>
            , <&key_physical_attrs 100 100  250  200       0    0    0>
            , <&key_physical_attrs 100 100  350  200       0    0    0>
            , <&key_physical_attrs 100 100  450  200       0    0    0>
            , <&key_physical_attrs 100 100  550  200       0    0    0>
            , <&key_physical_attrs 100 100 1150  200       0    0    0>
            , <&key_physical_attrs 100 100 1250  200       0    0    0>
            , <&key_physical_attrs 100 100 1350  200       0    0    0>
            , <&key_physical_attrs 100 100 1450  200       0    0    0>
            , <&key_physical_attrs 100 100 1550  225       0    0    0>
            , <&key_physical_attrs 150 100 1650  225       0    0    0>
            , <&key_physical_attrs 150 100    0  325       0    0    0>
            , <&key_physical_attrs 100 100  150  325       0    0    0>
            , <&key_physical_attrs 100 100  250  300       0    0    0>
            , <&key_physical_attrs 100 100  350  300       0    0    0>
            , <&key_physical_attrs 100 100  450  300       0    0    0>
            , <&key_physical_attrs 100 100  550  300       0    0    0>
            , <&key_physical_attrs 100 100 1150  300       0    0    0>
            , <&key_physical_attrs 100 100 1250  300       0    0    0>
            , <&key_physical_attrs 100 100 1350  300       0    0    0>
            , <&key_physical_attrs 100 100 1450  300       0    0    0>
            , <&key_physical_attrs 100 100 1550  325       0    0    0>
            , <&key_physical_attrs 150 100 1650  325       0    0    0>
            , <&key_physical_attrs 100 100  150  425       0    0    0>
            , <&key_physical_attrs 100 100  250  400       0    0    0>
            , <&key_physical_attrs 100 100  350  400       0    0    0>
            , <&key_physical_attrs 100 100  450  400       0    0    0>
            , <&key_physical_attrs 100 100 1250  400       0    0    0>
            , <&key_physical_attrs 100 100 1350  400       0    0    0>
            , <&key_physical_attrs 100 100 1450  400       0    0    0>
            , <&key_physical_attrs 100 100 1550  425       0    0    0>
            , <&key_physical_attrs 100 200  590  540    1500  590  440>
            , <&key_physical_attrs 100 200  690  540    1500  590  440>
            , <&key_physical_attrs 100 100  690  440    1500  590  440>
            , <&key_physical_attrs 100 100  790  440    1500  590  440>
            , <&key_physical_attrs 100 100  790  540    1500  590  440>
            , <&key_physical_attrs 100 100  790  640    1500  590  440>
            , <&key_physical_attrs 100 100  910  640 (-1500) 1210  440>
            , <&key_physical_attrs 100 100  910  540 (-1500) 1210  440>
            , <&key_physical_attrs 100 100  910  440 (-1500) 1210  440>
            , <&key_physical_attrs 100 100 1010  440 (-1500) 1210  440>
            , <&key_physical_attrs 100 200 1010  540 (-1500) 1210  440>
            , <&key_physical_attrs 100 200 1110  540 (-1500) 1210  440>
            ;
    };
};
