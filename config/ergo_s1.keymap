/*
 * Ergo S1 keymap (ZMK v0.3)
 *
 * Key order matches ergo_s1-layouts.dtsi:
 *   4 rows x 12, then the bottom row (4 + 4), then left thumbs (6) and right thumbs (6).
 *   Left thumbs : Shift  Fn     Ctrl   Alt    Home   End
 *   Right thumbs: PgDn   PgUp   Caps   Ctrl   Enter  Space
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define FN   1

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4    &kp N5      &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp BSPC
&kp LGUI  &kp Q  &kp W  &kp E    &kp R     &kp T       &kp Y  &kp U  &kp I     &kp O    &kp P    &kp EQUAL
&kp TAB   &kp A  &kp S  &kp D    &kp F     &kp G       &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
&kp DEL   &kp Z  &kp X  &kp C    &kp V     &kp B       &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &kp MINUS
          &kp MINUS &kp BSLH &kp LEFT &kp RIGHT          &kp UP &kp DOWN &kp LBKT &kp RBKT
&kp LSHFT &mo FN &kp LCTRL &kp LALT &kp HOME &kp END
&kp PG_DN &kp PG_UP &kp CAPS &kp RCTRL &kp ENTER &kp SPACE
            >;
        };

        fn_layer {
            display-name = "Fn";
            bindings = <
&studio_unlock &kp F1 &kp F2 &kp F3 &kp F4 &kp F5    &trans &kp KP_NUM &kp KP_EQUAL &kp KP_SLASH &kp KP_MULTIPLY &trans
&trans &kp F6 &kp F7 &kp F8 &kp F9 &kp F10           &trans &kp KP_N7  &kp KP_N8    &kp KP_N9    &kp KP_MINUS    &trans
&trans &trans &trans &trans &trans &trans            &trans &kp KP_N4  &kp KP_N5    &kp KP_N6    &kp KP_PLUS     &trans
&trans &trans &trans &trans &trans &kp PSCRN         &trans &kp KP_N1  &kp KP_N2    &kp KP_N3    &kp KP_ENTER    &trans
       &trans &kp INS &kp C_VOL_DN &kp C_VOL_UP             &kp KP_N0  &kp KP_DOT   &trans       &kp KP_ENTER
&trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
            >;
        };

        /* Empty slots ZMK Studio can turn into new layers */
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
    };
};
